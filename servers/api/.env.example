NODE_ENV=development
AUTH_MODE=local-demo
API_HOST=127.0.0.1
API_PORT=4000
WEB_ORIGIN=http://localhost:3000
LOG_LEVEL=debug
# Google authentication requires MongoDB and all three Google settings.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=http://localhost:4000/auth/google/callback
# MONGODB_URI=mongodb://localhost:27017/nutshyll
# Supabase Storage
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SECRET_KEY=your-supabase-secret-key
# SUPABASE_BUCKET=squid-drive-files
# Google OAuth values are supplied through the variables listed above.
