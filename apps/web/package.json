    "test": "tsx --test tests/integration/home-page.test.tsx tests/environment.test.ts tests/loopback-server.test.ts features/auth/tests/*.test.ts features/drive/tests/*.test.ts features/drive/tests/drive-workspace.test.tsx",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@aiden0z/pptx-renderer": "1.4.0",
    "@workspace/types": "workspace:*",
    "@workspace/ui": "workspace:*",
