{
  "name": "api",
  "type": "server",
  "description": "Primary Express API runtime.",
  "internalDependencies": ["eslint-config", "logging", "tsconfig", "types"],
  "externalDependencies": ["dotenv", "express", "google-auth-library", "mongoose", "zod"],
  "capabilities": ["http-api", "health", "mongodb-integration", "auth-session-foundation", "google-oidc-login", "session-validation", "session-revocation", "csrf-origin-protection"],
  "tasks": {
    "dev": { "command": "pnpm run dev", "environment": ["API_HOST", "API_PORT", "WEB_ORIGIN", "MONGODB_URI", "AUTH_MODE", "GOOGLE_CLIENT_ID", "GOOGLE_CLIENT_SECRET", "GOOGLE_REDIRECT_URI"], "cache": false },
    "build": { "command": "pnpm run build", "outputs": ["dist"], "cache": true },
    "test": { "command": "pnpm test", "cache": false },
    "lint": { "command": "pnpm run lint", "cache": false },
    "typecheck": { "command": "pnpm run typecheck", "cache": false }
  }
}
